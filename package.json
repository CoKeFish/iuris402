    "@x402/fetch": "^2.32.0",
    "@x402/stellar": "^2.32.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "unpdf": "^1.9.1"
  },
  "scripts": {
    "descargar": "node --use-system-ca ingesta/descargar.js",
    "curar": "node ingesta/curar.js",
    "citar": "node --use-system-ca ingesta/citar.js",
